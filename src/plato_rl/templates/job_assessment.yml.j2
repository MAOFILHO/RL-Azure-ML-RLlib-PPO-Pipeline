$schema: https://azuremlschemas.azureedge.net/latest/commandJob.schema.json
code: {{ code_path }}
command: >-
  python main.py --checkpoint-folder {% raw %}${{inputs.checkpoint_folder}}{% endraw %} --input-json {% raw %}${{inputs.input_json}}{% endraw %}
inputs:
  checkpoint_folder:
    type: uri_folder
    path: {{ checkpoint_path }}
    mode: download
  input_json:
    type: uri_file
    path: {{ init_conditions_path }}
    mode: download
environment: azureml:{{ environment_name }}@latest
compute: azureml:{{ compute_name }}
display_name: plato-custom-assessment
experiment_name: plato-custom-assessment
description: Run custom assessments on a trained agent.
distribution:
  type: mpi
resources:
  instance_count: {{ instance_count }}
